{
  "description": "Custom pages as stored on the phone and in a setup link (`prefs.pages`, docs/SHARING.md) → the pages the app reads. `input` is the stored text; `expected` lists every page in full (id, title, sections with their blocks; `output` only on switch blocks; action blocks with `id`, `name` and `steps`). Made-up ids and output keys.",
  "cases": [
    {
      "name": "A page with two sections",
      "input": "[{\"id\":\"k3\",\"title\":\"Movie night\",\"sections\":[{\"blocks\":[{\"kind\":\"hdmi\"},{\"kind\":\"switch\",\"output\":\"shellyplus1pm-112233445566/0\"}]},{\"blocks\":[{\"kind\":\"amp_volume\"}]}]}]",
      "expected": [
        {
          "id": "k3",
          "title": "Movie night",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "hdmi"
                },
                {
                  "kind": "switch",
                  "output": "shellyplus1pm-112233445566/0"
                }
              ]
            },
            {
              "blocks": [
                {
                  "kind": "amp_volume"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Forgiving: unknown block dropped, output on a non-switch block ignored, missing title becomes Page, page without id dropped, duplicate id: the first wins",
      "input": "[{\"id\":\"a\",\"blocks\":[{\"kind\":\"nope\"},{\"kind\":\"hdmi\",\"output\":\"ignored\"}]},{\"title\":\"x\"},{\"id\":\"a\",\"title\":\"dup\"}]",
      "expected": [
        {
          "id": "a",
          "title": "Page",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "hdmi"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "A page from before sections (a plain blocks list) is one section",
      "input": "[{\"id\":\"k3\",\"title\":\"Old\",\"blocks\":[{\"kind\":\"hdmi\"},{\"kind\":\"amp_keys\"}]}]",
      "expected": [
        {
          "id": "k3",
          "title": "Old",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "hdmi"
                },
                {
                  "kind": "amp_keys"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "No sections at all: one empty section, so the editor always has one to fill",
      "input": "[{\"id\":\"e\",\"title\":\"Empty\",\"sections\":[]}]",
      "expected": [
        {
          "id": "e",
          "title": "Empty",
          "sections": [
            {
              "blocks": []
            }
          ]
        }
      ]
    },
    {
      "name": "A switch block without an output is kept with an empty one (the editor shows it as a removed output)",
      "input": "[{\"id\":\"s\",\"title\":\"Lights\",\"sections\":[{\"blocks\":[{\"kind\":\"switch\"}]}]}]",
      "expected": [
        {
          "id": "s",
          "title": "Lights",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "switch",
                  "output": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Title and id are trimmed",
      "input": "[{\"id\":\" k3 \",\"title\":\"  Radio \",\"sections\":[{\"blocks\":[]}]}]",
      "expected": [
        {
          "id": "k3",
          "title": "Radio",
          "sections": [
            {
              "blocks": []
            }
          ]
        }
      ]
    },
    {
      "name": "An action block: steps in order; an unknown step, an IR step without a key and a switch step without an output are dropped, a wait is kept within 1–60 s, a missing name becomes Action",
      "input": "[{\"id\":\"m\",\"title\":\"Movie\",\"sections\":[{\"blocks\":[{\"kind\":\"action\",\"id\":\"a1\",\"steps\":[{\"do\":\"stick_on\"},{\"do\":\"tv_wake\"},{\"do\":\"wait\",\"seconds\":90},{\"do\":\"ir\",\"key\":\"Amp Power\"},{\"do\":\"ir\"},{\"do\":\"switch_off\",\"output\":\"shellyplus1pm-112233445566/0\"},{\"do\":\"switch_on\"},{\"do\":\"teleport\"},{\"do\":\"wait\"},{\"do\":\"stick_off\"}]}]}]}]",
      "expected": [
        {
          "id": "m",
          "title": "Movie",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "action",
                  "id": "a1",
                  "name": "Action",
                  "steps": [
                    {
                      "do": "stick_on"
                    },
                    {
                      "do": "tv_wake"
                    },
                    {
                      "do": "wait",
                      "seconds": 60
                    },
                    {
                      "do": "ir",
                      "key": "Amp Power"
                    },
                    {
                      "do": "switch_off",
                      "output": "shellyplus1pm-112233445566/0"
                    },
                    {
                      "do": "wait",
                      "seconds": 1
                    },
                    {
                      "do": "stick_off"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "An action block without an id is dropped",
      "input": "[{\"id\":\"m\",\"title\":\"Movie\",\"sections\":[{\"blocks\":[{\"kind\":\"action\",\"name\":\"On\"},{\"kind\":\"hdmi\"}]}]}]",
      "expected": [
        {
          "id": "m",
          "title": "Movie",
          "sections": [
            {
              "blocks": [
                {
                  "kind": "hdmi"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Not JSON: no pages",
      "input": "not json",
      "expected": []
    }
  ]
}
