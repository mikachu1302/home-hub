{
  "description": "HTTP digest authentication (RFC 2617 / RFC 7616), as the IR bridge (ESPHome, MD5) and Shelly (SHA-256) use it. 'challenges': a WWW-Authenticate header -> the parsed challenge, or null when the app cannot answer it. 'responses': the 'response' value for a request; the first two are the RFCs' own examples, the third is the RFC 2069 form without qop, the fourth has the shape of an ESPHome bridge press (made-up user, password and nonce). Values were computed with Python's hashlib.",
  "challenges": [
    {
      "name": "ESPHome bridge",
      "input": "Digest realm=\"Login Required\", qop=\"auth\", nonce=\"00112233445566778899aabbccddeeff\", opaque=\"ffeeddccbbaa99887766554433221100\"",
      "expected": {"realm": "Login Required", "nonce": "00112233445566778899aabbccddeeff", "qop": "auth", "opaque": "ffeeddccbbaa99887766554433221100", "algorithm": "MD5"}
    },
    {
      "name": "Shelly style, SHA-256, bare values",
      "input": "Digest qop=\"auth\", realm=\"shellyplus1pm-000000000001\", nonce=\"1700000000\", algorithm=SHA-256",
      "expected": {"realm": "shellyplus1pm-000000000001", "nonce": "1700000000", "qop": "auth", "opaque": null, "algorithm": "SHA-256"}
    },
    {
      "name": "Several qop options, comma inside quotes",
      "input": "digest realm=\"a, b\", nonce=\"n\", qop=\"auth-int, auth\"",
      "expected": {"realm": "a, b", "nonce": "n", "qop": "auth", "opaque": null, "algorithm": "MD5"}
    },
    {
      "name": "No qop (RFC 2069)",
      "input": "Digest realm=\"r\", nonce=\"n\"",
      "expected": {"realm": "r", "nonce": "n", "qop": null, "opaque": null, "algorithm": "MD5"}
    },
    {"name": "Basic is not digest", "input": "Basic realm=\"Login Required\"", "expected": null},
    {"name": "Only auth-int offered", "input": "Digest realm=\"r\", nonce=\"n\", qop=\"auth-int\"", "expected": null},
    {"name": "Unknown algorithm", "input": "Digest realm=\"r\", nonce=\"n\", algorithm=SHA-512-256", "expected": null},
    {"name": "No nonce", "input": "Digest realm=\"r\"", "expected": null}
  ],
  "responses": [
    {
      "name": "RFC 2617 example",
      "algorithm": "MD5", "user": "Mufasa", "password": "Circle Of Life", "realm": "testrealm@host.com",
      "method": "GET", "uri": "/dir/index.html", "nonce": "dcd98b7102dd2f0e8b11d0f600bfb0c093",
      "qop": "auth", "nc": "00000001", "cnonce": "0a4f113b",
      "expected": "6629fae49393a05397450978507c4ef1"
    },
    {
      "name": "RFC 7616 example (SHA-256)",
      "algorithm": "SHA-256", "user": "Mufasa", "password": "Circle of Life", "realm": "http-auth@example.org",
      "method": "GET", "uri": "/dir/index.html", "nonce": "7ypf/xlj9XXwfDPEoM4URrv/xwf94BcCAzFZH4GiTo0v",
      "qop": "auth", "nc": "00000001", "cnonce": "f2/wE4q74E6zIJEtWaHKaf5wv/H5QzzpXusqGemxURZJ",
      "expected": "753927fa0e85d155564e2e272a28d1802ca10daf4496794697cf8db5856cb6c1"
    },
    {
      "name": "RFC 2069 form (no qop)",
      "algorithm": "MD5", "user": "Mufasa", "password": "Circle Of Life", "realm": "testrealm@host.com",
      "method": "GET", "uri": "/dir/index.html", "nonce": "dcd98b7102dd2f0e8b11d0f600bfb0c093",
      "qop": null, "nc": null, "cnonce": null,
      "expected": "670fd8c2df070c60b045671b8b24ff02"
    },
    {
      "name": "Bridge button press",
      "algorithm": "MD5", "user": "bridge-user", "password": "not-the-real-password", "realm": "Login Required",
      "method": "POST", "uri": "/button/Amp%20Volume%20Up/press", "nonce": "00112233445566778899aabbccddeeff",
      "qop": "auth", "nc": "00000002", "cnonce": "cafe0001",
      "expected": "dd524f5da309456888b91f10b930b5ba"
    }
  ]
}
