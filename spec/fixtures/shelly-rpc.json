    {
      "name": "Neither result nor error",
      "input": {"id": 7, "src": "shellyplus1pm-112233445566"},
      "expected": {"error": "Unexpected answer"}
    },
    {
      "name": "Not JSON",
      "input": "Not Found",
      "expected": {"error": "Unexpected answer"}
    }
  ]
