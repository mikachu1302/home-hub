{
  "description": "Outputs -> room groups. Rooms follow the optional roomOrder (case-insensitive); rooms not in it come next, alphabetically ignoring case; the same room however it is capitalised (first spelling wins); items keep their order inside a room; outputs without a room (blank or spaces) last as a group with room null. Input: {outputs: [{name, room}], roomOrder?: [room]}. Made-up names.",
  "cases": [
    {
      "name": "Mixed",
      "input": {
        "outputs": [
          {
            "name": "Lamp",
            "room": "Living room"
          },
          {
            "name": "Ceiling",
            "room": "Aisle"
          },
          {
            "name": "Socket",
            "room": ""
          },
          {
            "name": "Strip",
            "room": "living room"
          },
          {
            "name": "Fan",
            "room": "  "
          }
        ]
      },
      "expected": [
        {
          "room": "Aisle",
          "items": [
            "Ceiling"
          ]
        },
        {
          "room": "Living room",
          "items": [
            "Lamp",
            "Strip"
          ]
        },
        {
          "room": null,
          "items": [
            "Socket",
            "Fan"
          ]
        }
      ]
    },
    {
      "name": "No rooms at all",
      "input": {
        "outputs": [
          {
            "name": "A",
            "room": ""
          },
          {
            "name": "B",
            "room": ""
          }
        ]
      },
      "expected": [
        {
          "room": null,
          "items": [
            "A",
            "B"
          ]
        }
      ]
    },
    {
      "name": "Every output has a room",
      "input": {
        "outputs": [
          {
            "name": "A",
            "room": "Kitchen"
          },
          {
            "name": "B",
            "room": " Kitchen "
          }
        ]
      },
      "expected": [
        {
          "room": "Kitchen",
          "items": [
            "A",
            "B"
          ]
        }
      ]
    },
    {
      "name": "Empty",
      "input": {
        "outputs": []
      },
      "expected": []
    },
    {
      "name": "Room order set, unknown rooms after it",
      "input": {
        "outputs": [
          {
            "name": "Lamp",
            "room": "Living room"
          },
          {
            "name": "Ceiling",
            "room": "Aisle"
          },
          {
            "name": "Fridge",
            "room": "Kitchen"
          },
          {
            "name": "Socket",
            "room": ""
          }
        ],
        "roomOrder": [
          "kitchen",
          "Living room",
          "Gone room"
        ]
      },
      "expected": [
        {
          "room": "Kitchen",
          "items": [
            "Fridge"
          ]
        },
        {
          "room": "Living room",
          "items": [
            "Lamp"
          ]
        },
        {
          "room": "Aisle",
          "items": [
            "Ceiling"
          ]
        },
        {
          "room": null,
          "items": [
            "Socket"
          ]
        }
      ]
    }
  ]
}
