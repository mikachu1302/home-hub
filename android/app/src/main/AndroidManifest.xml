<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android needs INTERNET for any socket, including the LAN connections to the devices.
         The app never talks to anything outside the LAN (see AGENTS.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Multicast is needed for mDNS discovery of the Shelly devices. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Only while the TV page's mic key is held: voice search on the TV (from tv-remote). The audio goes to the TV only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 17: local-network access is a runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Shelly devices and the IR bridge speak plain HTTP on the LAN, so cleartext has to be allowed.
         Acceptable only because all network code goes through the LAN-only client (AGENTS.md). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_neon"
        android:label="@string/app_name"
        android:theme="@style/Theme.HomeHub"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher entry is one of the aliases below, the one matching the colours (ui/LauncherIcon.kt). -->
            <!-- A shared setup (docs/SHARING.md): homehub://import?d=…, opened from the camera's QR scanner.
                 Nothing is applied before the user confirms. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="homehub" android:host="import" />
            </intent-filter>
        </activity>
        <!-- BEGIN launcher aliases (tools/gen_launcher_icons.py) -->
        <activity-alias
            android:name=".LauncherNeon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_neon"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
